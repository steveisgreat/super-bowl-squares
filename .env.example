# Copy to .env.local and paste your real Neon connection string.
# .env.local is gitignored. Never commit the real value.
#
# Use Neon's POOLED connection string — the host contains "-pooler".
# Serverless functions open many short-lived connections and the direct
# (non-pooled) string will exhaust the connection limit.
#
# Leave DATABASE_URL unset to run against the local fs backend instead.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Host password for the cloud deploy. Managing games (the saved-games list,
# create, edit, delete, phone score entry) requires it; reading one game by
# its id — the player QR view and the TV grid — never does.
#
# Leave HOST_PASSWORD unset to disable sign-in entirely. That is the LAN
# default: on a home network the network itself is the boundary, and nobody
# wants a password prompt on the couch.
#
# REQUIRED, not advice: use a long random value (a passphrase of 4+ random
# words, or 20+ random characters).
#
# There is no attempt-rate limit behind this and there cannot be a cheap one:
# serverless instances share no memory, so a counter would need its own table.
# A failed login costs a fixed 400ms delay, and that delay is SERIAL — fifty
# guesses fired in parallel all pay it at once, so it slows a single-threaded
# guesser and nothing else. The password's own entropy is the entire defense.
#
# It also signs the session cookie unless SESSION_SECRET is set below, so a
# weak value here weakens cookie forgery resistance too, not just the login.
HOST_PASSWORD=

# Optional. Signs the session cookie. Defaults to HOST_PASSWORD, which means
# changing the password signs every device out. Set this to a separate random
# value if you want to rotate one without the other.
SESSION_SECRET=
